{
  "name": "sealbridge-site",
  "main": "./site-worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
