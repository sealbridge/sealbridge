  "task": {
    "title": "Summarize architecture documents after owner opening",
    "description": "After connection admission, inspection and owner opening, read the provided documents through the scoped capability and return the agreed structured summary.",
    "acceptanceCriteria": [
      {
        "id": "ac_schema_valid",
        "description": "Output JSON strictly conforms to io.outputSchema.",
        "required": true
      },
      {
        "id": "ac_citations_present",
        "description": "Every finding includes a source document SHA-256 digest and line range.",
        "required": true
      }
    ]
  },
  "io": {
    "inputSchema": {
      "type": "object",
      "required": [
        "docUris"
      ],
      "properties": {
        "docUris": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "summary",
        "findings"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "severity",
              "sourceDigest"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
